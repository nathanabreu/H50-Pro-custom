# Copie para .env. O .env fica fora do git. TUDO aqui é opcional: os robôs se cadastram pela interface.

# --- onde o painel escuta ---
H50_HOST=127.0.0.1            # 0.0.0.0 para acessar de outros aparelhos (exige senha)
H50_PORT=8050
H50_DATA_DIR=data             # robots.json (tokens), bancos, sessão da nuvem, configurações

# --- segurança ---
# H50_PASSWORD=               # vazio = a senha é criada no primeiro acesso (código aparece no console)
# H50_AUTH=on                 # "off" só é aceito em localhost
# H50_TRUST_PROXY=false       # true somente atrás de proxy/túnel confiável
# H50_COOKIE_SECURE=false     # true atrás de HTTPS
# H50_VIEWER_PASSWORD=        # senha de um perfil SOMENTE LEITURA (ver, sem comandos); também dá para definir na tela
# H50_METRICS_TOKEN=          # libera GET /metrics (Prometheus) com 'Authorization: Bearer <token>'; use um valor longo e aleatório
# H50_ALLOWED_HOSTS=          # nomes extras aceitos no cabeçalho Host (só em localhost sem proxy; ex.: meu-pc.local)

# --- ferramentas ---
# RAW_ENABLED=false           # true libera escrever propriedades e executar ações (aba Laboratório)
# H50_BACKUP_PASSPHRASE=      # senha do backup para `python -m h50console backup` em agendadores

# --- migração de uma instalação de UM robô (só usados se ainda não existir robots.json) ---
# H50_IP=192.168.1.50
# H50_TOKEN=                  # 32 caracteres hexadecimais
# H50_NAME=Meu robô
